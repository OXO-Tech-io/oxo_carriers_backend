# Database Configuration
# Standard PostgreSQL Connection (local development or external DB)
DB_HOST=localhost
DB_PORT=5432
DB_USER=hris_user
DB_PASSWORD=oXo@59sd*fg34C
# Optional: use a mounted secret file instead of inline DB_PASSWORD
# DB_PASSWORD_FILE=/secrets/db-password
DB_NAME=oxo_hris
DB_SCHEMA=hris
DB_SSL=false

# Google Cloud SQL Configuration (production/staging)
# When CLOUD_SQL_CONNECTION_NAME is set, it takes precedence over DB_HOST/DB_PORT
# Format: PROJECT_ID:REGION:INSTANCE_NAME
# Example: oxo-career-guidance-platform:us-central1:cgp-instance
CLOUD_SQL_CONNECTION_NAME=oxo-career-guidance-platform:us-central1:cgp-instance

# Alternative: Direct socket path (if using local Cloud SQL Proxy)
# DB_SOCKET_PATH=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Application Configuration
NODE_ENV=development
PORT=5000

# JWT Authentication (for database-based login)
JWT_SECRET=your-super-secret-key-min-32-characters-change-in-production
JWT_EXPIRES_IN=24h

# Keycloak Configuration
KC_URL=https://keycloak-297614602590.us-central1.run.app
KC_REALM=oxo-hris
# KC_AUDIENCE is OPTIONAL. Leave it empty/unset to disable audience validation
# (recommended unless an audience mapper is configured on the issuing Keycloak
# client). If set (comma-separated), the token's `aud` must include one of them.
KC_AUDIENCE=
# CLIENT_ID is the client name, NOT the secret. Copy the secret from
# Keycloak Admin → Clients → oxo-carriers-backend → Credentials.
KC_BACKEND_CLIENT_ID=oxo-carriers-backend
KC_BACKEND_CLIENT_SECRET=your_keycloak_client_secret_here

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@oxocarriers.com

# Or SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password

# Frontend URL (for CORS)
FRONTEND_URL=https://oxo-carriers-frontend-297614602590.us-central1.run.app
# Additional allowed origins (comma-separated)
ALLOWED_ORIGINS=https://oxo-carriers-frontend-297614602590.us-central1.run.app,http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# PgAdmin (Docker only)
PGADMIN_EMAIL=admin@oxocarriers.com
PGADMIN_PASSWORD=admin123

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
