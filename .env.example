# Database Configuration
# Standard PostgreSQL Connection (local development or external DB)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=oxo_carriers
DB_SCHEMA=hris1
DB_SSL=false

# Google Cloud SQL Configuration (production/staging)
# When CLOUD_SQL_CONNECTION_NAME is set, it takes precedence over DB_HOST/DB_PORT
# Format: PROJECT_ID:REGION:INSTANCE_NAME
# Example: my-gcp-project:us-central1:oxo-carriers-db
CLOUD_SQL_CONNECTION_NAME=

# Alternative: Direct socket path (if using local Cloud SQL Proxy)
# DB_SOCKET_PATH=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Application Configuration
NODE_ENV=development
PORT=5000

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@oxocarriers.com

# Or SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# PgAdmin (Docker only)
PGADMIN_EMAIL=admin@oxocarriers.com
PGADMIN_PASSWORD=admin123

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
