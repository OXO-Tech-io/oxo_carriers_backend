NODE_ENV=test
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=test_user
DB_PASSWORD=test_password
DB_NAME=test_db
DB_SCHEMA=public
DB_SSL=false

KC_URL=http://localhost:8080
KC_REALM=test-realm
KC_BACKEND_CLIENT_ID=test-backend-client
KC_BACKEND_CLIENT_SECRET=test-client-secret
KC_FRONTEND_CLIENT_ID=test-frontend-client

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASS=test-smtp-pass
